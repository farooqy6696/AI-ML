# --- Relational Database (PostgreSQL or MySQL) ---
# PostgreSQL example: postgresql+psycopg2://user:password@localhost:5432/epa_db
# MySQL example:      mysql+pymysql://user:password@localhost:3306/epa_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/epa_db

# --- MongoDB (stores uploaded document metadata / AI outputs) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=epa_documents

# --- JWT Auth ---
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Google Gemini API ---
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# --- App ---
UPLOAD_DIR=uploads
REPORTS_DIR=reports_output
ENVIRONMENT=development
